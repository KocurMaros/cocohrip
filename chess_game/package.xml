<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>chess_game</name>
  <version>0.0.0</version>
  <description>Chess against the UR5e: piece recognition, rules (python-chess), swappable engines</description>
  <maintainer email="eduard.zelenay@airvolute.com">Eduard Zelenay</maintainer>
  <license>Apache-2.0</license>

  <test_depend>python3-pytest</test_depend>

  <exec_depend>chess_msgs</exec_depend>
  <exec_depend>checkers_msgs</exec_depend>
  <!-- board corner detection (checkers_game.camera.board_geometry) -->
  <exec_depend>checkers_game</exec_depend>
  <!-- python-chess: pip install chess (not packaged for Ubuntu 24.04) -->
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
