<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:include filename="$(find robotiq_hande_description)/urdf/robotiq_hande_gripper.xacro"/>

  <xacro:macro name="cocohrip_cell" params="
    parent
    *origin
    ur_type
    joint_limits_parameters_file
    kinematics_parameters_file
    physical_parameters_file
    visual_parameters_file
    ">

    <joint name="table_base_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}" />
      <child link="table" />
    </joint>

    <link name="table">
      <visual>
        <geometry>
          <mesh filename="package://cocohrip_description/meshes/cocohrip.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://cocohrip_description/meshes/cocohrip.dae" />
        </geometry>
      </collision>
    </link>

<!--<link name="wall">
      <visual>
        <geometry>
           <box size="2 0.1 2" />
        </geometry>
        <material name="LightGrey">
          <color rgba="1 1 1 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="2 0.1 2" />
        </geometry>
      </collision>
    </link> -->

     <!-- <joint name="wall_joint" type="fixed">
    <parent link="robot_mount" />
    <child link = "wall" />
    <origin xyz="0 -0.2 0.0" rpy="0.0 0.0 0.0" />
  </joint> -->

    <link name="robot_mount"/>
    <joint name="base_to_robot_mount" type="fixed">
      <parent link="table"/>
      <child link="robot_mount"/>
      <origin xyz="1.05003  0.69327 0.01035" rpy="0.0 0.0 3.1415927" /> 
    </joint>

    <!--This will create the specific robot-->
    <xacro:ur_robot
      name="${ur_type}"
      tf_prefix="${ur_type}_"
      parent="robot_mount"
      joint_limits_parameters_file="${joint_limits_parameters_file}"
      kinematics_parameters_file="${kinematics_parameters_file}"
      physical_parameters_file="${physical_parameters_file}"
      visual_parameters_file="${visual_parameters_file}"
    >
      <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:ur_robot>

    <!--
      Real Robotiq Hand-E gripper (meshes + actuated mimic fingers), vendored from
      https://github.com/macmacal/robotiq_hande_description (Apache-2.0), replacing the earlier
      placeholder box (hande_gripper.xacro).

      use_fake_hardware is hardcoded to true here regardless of whether the ARM is real/mock:
      the actual gripper on this cell is still driven by the existing bespoke
      robotiq_hande_ros2_driver (gripper_srv, direct Modbus TCP), not by this package's
      ros2_control interface or robotiq_hande_driver. This only gives the gripper's own joints
      (left/right finger) a well-behaved mock state (mock_components/GenericSystem) so
      ros2_control/MoveIt have something to report; it does not change how the real gripper is
      commanded. The tty_port/baudrate/... args below are unused in fake-hardware mode but are
      required (no macro defaults) by robotiq_hande_gripper.xacro.
    -->
    <xacro:robotiq_hande_gripper
      name="${ur_type}_hande_gripper"
      prefix="${ur_type}_"
      parent="${ur_type}_tool0"
      grip_pos_min="0.0"
      grip_pos_max="0.025"
      tty_port="/tmp/ttyUR"
      baudrate="115200"
      parity="N"
      data_bits="8"
      stop_bit="1"
      slave_id="9"
      use_fake_hardware="true"
    />
  </xacro:macro>

</robot>